"Toolchain repos for BuildX"

load("//buildx/private:toolchains_repo.bzl", "PLATFORMS", "toolchains_repo")
load("//buildx/private:versions.bzl", "BUILDX_VERSIONS", "DEFAULT_BUILDX_VERSION")

_DOC = "Fetch external tools needed for buildx toolchain"
_ATTRS = {
    "buildx_version": attr.string(mandatory = True, values = BUILDX_VERSIONS.keys()),
    "platform": attr.string(mandatory = True, values = PLATFORMS.keys()),
}

def _buildx_repo_impl(rctx):
    ext = ".exe" if rctx.attr.platform.startswith("windows-") else ""
    url = "https://github.com/docker/buildx/releases/download/v{version}/buildx-v{version}.{platform}{ext}".format(
        version = rctx.attr.buildx_version,
        platform = rctx.attr.platform,
        ext = ext,
    )
    rctx.download(
        url = [url],
        sha256 = BUILDX_VERSIONS[rctx.attr.buildx_version][rctx.attr.platform],
        executable = True,
        output = "buildx" + ext,
    )
    rctx.file("BUILD.bazel", """# Generated by buildx/repositories.bzl
load("@rules_buildx//buildx:toolchain.bzl", "buildx_toolchain")

buildx_toolchain(
    name = "buildx_toolchain",
    buildx = ":buildx{ext}",
)
""".format(ext = ext))

buildx_repo = repository_rule(
    _buildx_repo_impl,
    doc = _DOC,
    attrs = _ATTRS,
)

# Wrapper macro around everything above, this is the primary API
def buildx_register_toolchains(name = "buildx", buildx_version = DEFAULT_BUILDX_VERSION, register = True, **kwargs):
    """Convenience macro for users which does typical setup.

    - create a repository for each built-in platform like "buildx_linux-amd64"
    - create a repository exposing toolchains for each platform, "buildx_toolchains"
    - register a toolchain pointing at each platform
    Users can avoid this macro and do these steps themselves, if they want more control.
    Args:
        name: base name for all created repos, like "buildx"
        register: whether to call through to native.register_toolchains.
            Should be True for WORKSPACE users, but false when used under bzlmod extension
        buildx_version: buildx version to use
        **kwargs: passed to each buildx_repo call
    """
    for platform in PLATFORMS.keys():
        buildx_repo(
            name = name + "_" + platform,
            platform = platform,
            buildx_version = buildx_version,
            **kwargs
        )
        if register:
            native.register_toolchains("@%s_toolchains//:%s_toolchain" % (name, platform))

    toolchains_repo(
        name = name + "_toolchains",
        user_repository_name = name,
    )
